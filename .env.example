# --- Datenbank (Google Sheet "Datenbank") ---
DB_SHEET_ID=
# --- bestehende GuV-Tabelle (nur lesen) ---
GUV_SHEET_ID=
# --- Drive: Ordner "Buchhaltung" ---
DRIVE_ROOT_FOLDER_ID=
# --- Google OAuth (npm run google:auth erzeugt den Refresh-Token) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# --- optional ---
CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# Ohne DB_SHEET_ID läuft die App im lokalen Modus (data/db/*.json)
